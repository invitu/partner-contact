<odoo>
    <record id="res_config_settings_view_form_family_minor" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div id="family">
                    <block title="Family" name="family_setting_container">
                        <setting
                            string="Minor Age Setting"
                            id="minor_age_setting"
                            help="Age below which a contact is considered a minor."
                            >
                            <field name="minor_age_limit" />
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
